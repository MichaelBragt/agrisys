<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Dialog title="Profil" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <dialogPane>
      <DialogPane headerText="Brugerprofil">
         <content>
            <GridPane hgap="12.0" vgap="8.0">
               <children>
                  <Label text="Bruger:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label text="Ikke angivet" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Gård:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Label text="Ikke angivet" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Rolle:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Label text="Ikke angivet" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </content>
         <buttonTypes>
            <ButtonType buttonData="OK_DONE" text="Luk" />
         </buttonTypes>
      </DialogPane>
   </dialogPane>
</Dialog>

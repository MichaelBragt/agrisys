<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" spacing="20.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.agrisys.controller.HomeController"
      styleClass="view-container">
    <children>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Farm Performance Dashboard" styleClass="header-label" />
            <Button fx:id="importButton" text="Import Excel Data" onAction="#handleImportAction" />
        </HBox>
    </children>
</VBox>
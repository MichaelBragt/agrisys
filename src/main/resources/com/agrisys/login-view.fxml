<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrisys.controller.LoginController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: -agri-secondary;"
      stylesheets="@style.css">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" maxWidth="400">
        
        <Label text="Agrisys Login" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: -agri-primary;"/>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Indtast brugernavn:"/>
            <TextField fx:id="usernameField" promptText="Indtast brugernavn..." maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Adgangskode:"/>
            <PasswordField fx:id="passwordField" promptText="Indtast adgangskode" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" textFill="red" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Log ind" onAction="#handleLogin" style="-fx-background-color: -agri-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;"/>
            <Button text="Afslut" onAction="#handleExit" style="-fx-background-color: transparent; -fx-border-color: -agri-primary; -fx-text-fill: -agri-primary; -fx-font-weight: bold; -fx-padding: 8 20; -fx-border-radius: 4;"/>
        </HBox>

        <Separator/>

        <!-- Test credentials section as requested by the user -->
        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-color: #e9ecef; -fx-border-radius: 4; -fx-background-radius: 4;">
            <Label text="Test Kontoer" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <VBox spacing="5" alignment="CENTER">
                <Label text="Landmand (Fuld adgang)" style="-fx-font-weight: bold;"/>
                <Label text="Brugernavn: Landmand  |  Kode: 1234"/>
            </VBox>
            
            <VBox spacing="5" alignment="CENTER">
                <Label text="Rådgiver (Read-only)" style="-fx-font-weight: bold;"/>
                <Label text="Brugernavn: Rådgiver  |  Kode: 5678"/>
            </VBox>
        </VBox>
    </VBox>
</VBox>

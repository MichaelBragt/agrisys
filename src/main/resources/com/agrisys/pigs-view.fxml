<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_LEFT" spacing="20.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrisys.controller.PigsController"
      styleClass="view-container">
    <children>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Pig Management (Grise)" styleClass="header-label" />
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="800.0">
                <TableView fx:id="pigTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colAnimalNumber" text="Dyr Nr." prefWidth="100" />
                        <TableColumn fx:id="colResponder" text="Responder ID" prefWidth="120" />
                        <TableColumn fx:id="colLocation" text="Lokation" prefWidth="80" />
                        <TableColumn fx:id="colBirthDate" text="Fødselsdato" prefWidth="100" />
                        <TableColumn fx:id="colWeight" text="Vægt (kg)" prefWidth="90" />
                        <TableColumn fx:id="colFCR" text="FCR" prefWidth="70" />
                    </columns>
                </TableView>

                <HBox alignment="TOP_LEFT">
                    <Button text="+ Registrer Ny Gris" onAction="#handleOpenRegistration" styleClass="action-button"/>
                </HBox>
            </VBox>

            <VBox fx:id="sideContent" prefWidth="450.0" minWidth="400.0" styleClass="sidebar-container" spacing="15" HBox.hgrow="NEVER">

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="Besætningens FCR Trend (Live)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <StackPane fx:id="chartContainer" VBox.vgrow="ALWAYS" minHeight="200.0" />
                </VBox>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="Vægtudvikling - Gris (Live)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <StackPane fx:id="weightChartContainer" VBox.vgrow="ALWAYS" minHeight="200.0" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Aktuel Staldstatus" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <StackPane fx:id="gaugeContainer2" alignment="CENTER" minHeight="150.0" />
                </VBox>
            </VBox>

        </HBox>
    </children>
</VBox>